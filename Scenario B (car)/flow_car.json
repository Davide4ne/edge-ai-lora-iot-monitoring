    {
        "id": "d635e340583dc6e5",
        "type": "function",
        "z": "7815250e5d93187d",
        "name": "function principale",
        "func": "let timestamp = new Date().toLocaleString();\n\nlet cars = Number(msg.payload.cars);\nlet postiTotali = 20;\n\nif (cars < 0) cars = 0;\nif (cars > postiTotali) cars = postiTotali;\n\nlet postiLiberi = postiTotali - cars;\n\nlet stato = cars >= postiTotali\n    ? \"🟥 PARCHEGGIO PIENO\"\n    : \"🟩 POSTI DISPONIBILI\";\n\nlet grid = {\n    cars: cars,\n    free: postiLiberi,\n    total: postiTotali\n};\n\nreturn [\n    { payload: stato },\n    { payload: grid },\n    { payload: timestamp },\n    {\n        payload: {\n            timestamp: timestamp,\n            cars: cars,\n            free: postiLiberi,\n            stato: stato\n        }\n    }\n];",
        "outputs": 4,
        "timeout": 0,
