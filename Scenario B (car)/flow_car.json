    {
        "id": "17f9464837d5de9a",
        "type": "ui_template",
        "z": "7815250e5d93187d",
        "group": "ec1f1bfd45d5268b",
        "name": "Park Grid",
        "order": 0,
        "width": "6",
        "height": "12",
        "format": "<div style=\"font-family: Arial; text-align:center;\">\n    <h3>Parcheggio</h3>\n\n    <div style=\"\n        display: grid;\n        grid-template-columns: repeat(5, 1fr);\n        gap: 8px;\n        justify-content: center;\n        margin-bottom: 10px;\n    \">\n        <div ng-repeat=\"i in [].constructor(msg.payload.total) track by $index\" style=\"\n                width: 100%;\n                height: 45px;\n                border-radius: 8px;\n                display: flex;\n                align-items: center;\n                justify-content: center;\n                color: white;\n                font-weight: bold;\n             \" ng-style=\"{\n                'background-color': $index < msg.payload.cars ? '#c62828' : '#2e7d32'\n             }\">\n            {{$index + 1}}\n        </div>\n    </div>\n\n    <div>\n        🚗 Occupati: <b>{{msg.payload.cars}}</b> /\n        🅿️ Liberi: <b>{{msg.payload.free}}</b>\n    </div>\n</div>",
        "storeOutMessages": true,
        "fwdInMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
        "className": "",
        "x": 740,
        "y": 120,
        "wires": [
            []
        ]
    },
    {
        "id": "e3f92cbc9bec65bd",
        "type": "function",
        "z": "7815250e5d93187d",
        "name": "function sql",
        "func": "let d = msg.payload;\n\nlet timestamp = d.timestamp;\nlet autoRilevate = Number(d.cars);\nlet postiLiberi = Number(d.free);\nlet stato = d.stato;\n\nif (isNaN(autoRilevate) || isNaN(postiLiberi)) {\n    node.warn(\"Valori non validi: \" + JSON.stringify(d));\n    return null;\n}\n\nmsg.topic = `\nINSERT INTO parcheggio (\n    timestamp,\n    auto_rilevate,\n    posti_liberi,\n    stato\n)\nVALUES (\n    '${timestamp}',\n    ${autoRilevate},\n    ${postiLiberi},\n    '${stato}'\n)\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
