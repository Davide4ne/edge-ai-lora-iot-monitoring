    {
        "id": "0b8863bdc79a345d",
        "type": "function",
        "z": "3aad79e80ba9f80a",
        "name": "function sql",
        "func": "let s = msg.payload;\n\n// Se arriva già come stringa CSV:\n// \"16/06/2026, 10:08:36,1,Egg,97.3\"\nlet parts = s.split(\",\");\n\nif (parts.length < 5) {\n    node.warn(\"Formato non valido: \" + s);\n    return null;\n}\n\nlet timestamp = parts[0].trim() + \", \" + parts[1].trim();\nlet egg = Number(parts[2].trim());\nlet label = parts[3].trim();\nlet prob = Number(parts[4].trim());\n\nmsg.topic = `\nINSERT INTO rilevazioni (timestamp, egg, label, prob)\nVALUES ('${timestamp}', ${egg}, '${label}', ${prob})\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 240,
        "wires": [
