        "z": "3aad79e80ba9f80a",
        "name": "function principale",
        "func": "let timestamp = new Date().toLocaleString();\nlet stato = msg.payload.egg ? \"🥚 UOVA PRESENTI\" : \"❌ NESSUN UOVO\";\nlet probabilita = Number((msg.payload.prob * 100).toFixed(1));\n\nreturn [\n    { payload: stato },\n    { payload: probabilita },\n    { payload: timestamp },\n    { payload: `${timestamp},${msg.payload.egg},${msg.payload.label},${probabilita}` }\n];",
